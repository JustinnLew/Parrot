{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parrot",
  "version": "0.1.0",
  "identifier": "com.justi.parrot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "decorations": false,
        "title": "Parrot",
        "width": 400,
        "height": 600,
        "resizable": true,
        "transparent": true,
        "noRedirectionBitmap": true,
        "shadow": false
      },
      {
        "label": "snip",
        "url": "index.html#/snip",
        "title": "Parrot Snip",
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$TEMP/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "src/ocr/detection/",
      "src/ocr/recognition/"
    ],
    "externalBin": [
      "binaries/lt"
    ]
  }
}
